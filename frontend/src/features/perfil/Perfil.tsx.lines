1:	import { useState, useEffect } from 'react';2:	import { useAuth } from '../../auth/AuthContext';3:	import api from '../../api/client';4:	5:	export default function Perfil() {6:	  const { user } = useAuth();7:	  const [form, setForm] = useState<{ username: string; nombre?: string }>({ username: user?.username || '', nombre: '' });8:	  const [loading, setLoading] = useState(true);9:	  const [saving, setSaving] = useState(false);10:	  const [msg, setMsg] = useState<string | null>(null);11:	  const [pwd, setPwd] = useState({ current: '', next: '', confirm: '' });12:	  const [pwdMsg, setPwdMsg] = useState<string | null>(null);13:	  const [pwdLocked, setPwdLocked] = useState(false);14:	15:	  useEffect(() => {16:	    let cancelled = false;17:	    async function load() {18:	      setLoading(true);19:	      try {20:	        // Intentar /me primero; si falla usar /users/:id21:	        let data;22:	        try {23:	          const r = await api.get('/api/users/me');24:	          data = r.data;25:	        } catch {26:	          const r = await api.get(`/api/users/${user?.id}`);27:	          data = r.data;28:	        }29:	        if (!cancelled) setForm({ username: data.username || user?.username, nombre: data.nombre || '' });30:	      } catch (e) {31:	        // noop32:	      } finally {33:	        if (!cancelled) setLoading(false);34:	      }35:	    }36:	    load();37:	    return () => { cancelled = true; };38:	  }, [user?.id, user?.username]);39:	40:	  async function onSubmit(e: React.FormEvent) {41:	    e.preventDefault();42:	    setMsg(null);43:	    if (!form.username.trim()) { setMsg('El username es obligatorio'); return; }44:	    setSaving(true);45:	    try {46:	      await api.put(`/api/users/${user?.id}`, { username: form.username, nombre: form.nombre });47:	      setMsg('Perfil actualizado');48:	    } catch (e: any) {49:	      setMsg(e?.response?.data?.message || 'No se pudo actualizar el perfil');50:	    } finally {51:	      setSaving(false);52:	    }53:	  }54:	55:	  async function onChangePassword(e: React.FormEvent) {56:	    e.preventDefault();57:	    setPwdMsg(null);58:	    if (!pwd.current || !pwd.next) { setPwdMsg('Completa todos los campos'); return; }59:	    if (pwd.next.length < 8) { setPwdMsg('La nueva contraseña debe tener al menos 8 caracteres'); return; }60:	    if (pwd.next !== pwd.confirm) { setPwdMsg('Las contraseñas no coinciden'); return; }61:	    setSaving(true);62:	    try {63:	      // Intentar varios endpoints y detectar contraseña actual incorrecta (400/401)64:	      const payload = { currentPassword: pwd.current, newPassword: pwd.next };65:	      const attempts = [66:	        () => api.post('/auth/change-password', payload),67:	        () => api.put(`/api/users/${user?.id}/password`, payload),68:	        () => api.patch('/api/users/me/password', payload),69:	      ];70:	      let lastError: any = null;71:	      for (const run of attempts) {72:	        try {73:	          await run();74:	          setPwd({ current: '', next: '', confirm: '' });75:	          setPwdMsg('Contraseña actualizada');76:	          setPwdLocked(false);77:	          return;78:	        } catch (err: any) {79:	          lastError = err;80:	          const status = err?.response?.status as number | undefined;81:	          const msg = (err?.response?.data?.message || '').toString().toLowerCase();82:	          if (status === 400 || status === 401 || msg.includes('actual') || msg.includes('current') || msg.includes('incorrect') || msg.includes('inválid') || msg.includes('errónea')) {83:	            setPwdMsg('Contraseña actual errónea');84:	            setPwdLocked(true);85:	            return; // no seguir intentando otros endpoints86:	          }87:	          // Otros errores: seguir intentando siguiente endpoint88:	        }89:	      }90:	      // Si llegó aquí, todos fallaron por otra razón91:	      throw lastError;92:	    } catch (e: any) {93:	      setPwdMsg(e?.response?.data?.message || 'No se pudo cambiar la contraseña');94:	    } finally {95:	      setSaving(false);96:	    }97:	  }98:	99:	  return (100:	    <div className="max-w-xl space-y-4">101:	      <h2 className="text-2xl font-semibold">Mi perfil</h2>102:	      {loading ? (103:	        <p>Cargando…</p>104:	      ) : (105:	        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">106:	          <form onSubmit={onSubmit} className="border rounded-xl p-4 bg-white space-y-3 shadow-sm">107:	            <h3 className="font-semibold">Datos de perfil</h3>108:	            <label className="block">109:	              <span className="text-sm text-gray-700">Username</span>110:	              <input className="mt-1 w-full border rounded p-2" value={form.username} onChange={(e) => setForm({ ...form, username: e.target.value })} />111:	            </label>112:	            <label className="block">113:	              <span className="text-sm text-gray-700">Nombre</span>114:	              <input className="mt-1 w-full border rounded p-2" value={form.nombre || ''} onChange={(e) => setForm({ ...form, nombre: e.target.value })} />115:	            </label>116:	            {msg && <p className={`text-sm ${msg.includes('actualizado') ? 'text-green-700' : 'text-red-700'}`}>{msg}</p>}117:	            <button disabled={saving} className="px-3 py-2 rounded bg-red-600 bg-brand-primary text-white">{saving ? 'Guardando…' : 'Guardar cambios'}</button>118:	          </form>119:	120:	          <form onSubmit={onChangePassword} className="border rounded-xl p-4 bg-white space-y-3 shadow-sm">121:	            <h3 className="font-semibold">Cambiar contraseña</h3>122:	            <label className="block">123:	              <span className="text-sm text-gray-700">Contraseña actual</span>124:	              <input className="mt-1 w-full border rounded p-2" type="password" value={pwd.current} onChange={(e) => { setPwd({ ...pwd, current: e.target.value }); setPwdLocked(false); setPwdMsg(null); }} />125:	            </label>126:	            <label className="block">127:	              <span className="text-sm text-gray-700">Nueva contraseña</span>128:	              <input className="mt-1 w-full border rounded p-2" type="password" value={pwd.next} onChange={(e) => setPwd({ ...pwd, next: e.target.value })} />129:	            </label>130:	            <label className="block">131:	              <span className="text-sm text-gray-700">Confirmar nueva</span>132:	              <input className="mt-1 w-full border rounded p-2" type="password" value={pwd.confirm} onChange={(e) => setPwd({ ...pwd, confirm: e.target.value })} />133:	            </label>134:	            {pwdMsg && <p className={`text-sm ${pwdMsg.includes('actualizada') || pwdMsg.includes('actualizado') ? 'text-green-700' : 'text-red-700'}`}>{pwdMsg}</p>}135:	            <button disabled={saving || pwdLocked} className={`px-3 py-2 rounded text-white ${pwdLocked ? 'bg-gray-400 cursor-not-allowed' : 'bg-red-600 bg-brand-primary hover:brightness-110'}`}>{saving ? 'Guardando…' : 'Cambiar contraseña'}</button>136:	          </form>137:	        </div>138:	      )}139:	    </div>140:	  );141:	}